# Roommate Expense Manager Environment Configuration
DEBUG=True
SECRET_KEY=django-insecure-roommate-expense-manager-super-secret-key-2026

# Database Configuration (PostgreSQL)
# Option A: Full Database URL
# DATABASE_URL=postgres://postgres:password@localhost:5432/roommate_manager_db

# Option B: Individual PostgreSQL parameters
# POSTGRES_DB=roommate_manager_db
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# (If neither DATABASE_URL nor POSTGRES_DB is provided, the app will automatically use local SQLite db.sqlite3)
